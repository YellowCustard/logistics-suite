# Copy to .env. Never commit .env. Generate secrets as shown.
POSTGRES_PASSWORD=change-me-local-only

# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated, newest first. Losing every key makes encrypted ID and phone numbers unrecoverable.
FIELD_ENCRYPTION_KEYS=change-me

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Local compose serves plain HTTP. In production terminate TLS at a proxy and set these to 1 / 3600+.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_BEHIND_TLS_PROXY=0
LOG_LEVEL=INFO
# Count variances (and direct corrections) larger than this % of system stock need a site manager
INVENTORY_VARIANCE_APPROVAL_PCT=2
# Sign-in attempts per client address per worker process
LOGIN_RATE_LIMIT=10/m
SYNC_PULL_OVERLAP_SECONDS=300
# GS1 company prefix for SSCC pallet and carton labels (7-10 digits, from GS1 South Africa) and the extension
# digit (0-9). Packing refuses to open handling units until the prefix is set.
GS1_COMPANY_PREFIX=
SSCC_EXTENSION_DIGIT=0
